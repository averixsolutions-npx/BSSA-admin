# Backend API base URL — no trailing slash
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Optional: public site URL (used for the "View site" link in topbar)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Organisation name shown in the admin chrome (sidebar, mobile nav, login, tab title).
# Set this to the full form of "BSSA"; falls back to "BSSA" when unset.
NEXT_PUBLIC_ORG_NAME="BSSA"
NEXT_PUBLIC_ORG_SHORT="BSSA"
