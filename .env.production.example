# Production environment variables — set these in the Vercel dashboard
# (Project Settings → Environment Variables → Production).
# The admin panel is a client-side app; all secrets live on the backend VPS, not here.

# Backend API — must be HTTPS in production, no trailing slash
NEXT_PUBLIC_API_URL=https://api.<domain>/api/v1

# Public site URL (for the "View site" link in the topbar)
NEXT_PUBLIC_SITE_URL=https://<domain>
